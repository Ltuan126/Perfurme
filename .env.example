# Server
PORT=5000
NODE_ENV=development

# MongoDB (replace with your MongoDB Atlas URI for production)
MONGO_URI=mongodb://localhost:27017/perfume

# JWT Secret (must be strong, at least 32 chars in production)
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=15m

# Refresh token secret (recommended to keep separate from JWT_SECRET)
REFRESH_TOKEN_SECRET=replace_with_separate_refresh_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REGISTER_MAX=5

# CORS (set to your frontend domain in production)
# Multiple origins can be separated by commas
# Example: https://your-app.vercel.app,https://your-app-git-main-your-team.vercel.app
CORS_ORIGIN=https://elegancefragrance.vercel.app,http://localhost:3000

# Payment Gateway - Momo
# Leave empty if you only use COD. Required when enabling momo method.
MOMO_PARTNER_CODE=replace_with_momo_partner_code
MOMO_ACCESS_KEY=replace_with_momo_access_key
MOMO_SECRET_KEY=replace_with_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/payment/callback
MOMO_IPN_URL=http://localhost:5000/api/payment/callback?method=momo

# Payment Gateway - VNPay
# Leave empty if you only use COD. Required when enabling vnpay method.
VNPAY_TMN_CODE=replace_with_vnpay_tmn_code
VNPAY_HASH_SECRET=replace_with_vnpay_hash_secret
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/callback

# Frontend (Vercel)
REACT_APP_API_BASE_URL=https://your-backend-domain.example.com

# Security note after incident/revoke:
# 1) Rotate all keys at provider side
# 2) Update values in Vercel Environment Variables
# 3) Redeploy all environments (Preview + Production)
